# ============================================================
# OEE What-If & RCA Backend — Ortam Yapılandırması (ÖRNEK)
# Bu dosyayı '.env' olarak kopyalayıp değerleri düzenleyin:
#     cp .env.example .env
# '.env' git'e EKLENMEZ (.gitignore); '.env.example' paylaşılır.
# ============================================================

# Veri seti klasörü (config.py'ye göre göreli yol; mutlak da verilebilir)
OEE_DATA_DIR=../uludag_hackathon_dataset

# API sunucusu
OEE_API_HOST=127.0.0.1
OEE_API_PORT=8000
OEE_CORS_ORIGINS=*
OEE_LOG_LEVEL=info

# Alan ayarları
OEE_CURRENCY=₺
OEE_RCA_WINDOW_MINUTES=15

# Gemini (Google) AI kök neden analizi — kendi anahtarını gir (boşsa yerel özet kullanılır)
OEE_GEMINI_API_KEY=
OEE_GEMINI_MODEL=gemini-2.0-flash
